    <record id="res_config_settings_view_form_stock_cargoson" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.delivery.cargoson.stock</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='shipping_connectors_setting_container']" position="inside">
                <setting id="shipping_costs_cargoson" help="Compute shipping costs and ship with Shiprocket">
                    <div class="content-group">
                        <div class="mt8">
                            <button name="%(delivery.action_delivery_carrier_form)d" icon="oi-arrow-right" type="action" string="cargoson Shipping Methods" class="btn-link" context="{'search_default_delivery_type': 'cargoson'}"/>
                        </div>
                     </div>
                </setting>
            </xpath>
        </field>
    </record>

